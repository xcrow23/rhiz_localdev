{
  "name": "Fathom Commander Heartbeat",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 60
            }
          ]
        }
      },
      "name": "Every 60 Seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{$env.FATHOM_COMMANDER_URL}}/heartbeat",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Poll Heartbeat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "trading-halted",
              "leftValue": "={{ $json.trading_halted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "name": "Check Alerts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "pending-approvals",
              "leftValue": "={{ $json.pending_approvals.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "name": "Pending Approvals?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 500]
    },
    {
      "parameters": {
        "channel": "#trading",
        "text": "=:rotating_light: *Trading Halted*\nReason: {{ $json.halt_reason }}\nMode: {{ $json.mode }}",
        "otherOptions": {}
      },
      "name": "Alert: Trading Halted",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [850, 200],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "channel": "#trading",
        "text": "=:question: *Pending Approvals*\nCount: {{ $json.pending_approvals.count }}\nIDs: {{ $json.pending_approvals.ids.join(', ') }}",
        "otherOptions": {}
      },
      "name": "Alert: Pending Approvals",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [850, 500],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "={{ $json.status }}"
            },
            {
              "name": "uptime",
              "value": "={{ $json.uptime }}"
            },
            {
              "name": "mode",
              "value": "={{ $json.mode }}"
            },
            {
              "name": "trades_today",
              "value": "={{ $json.today.trades }}"
            },
            {
              "name": "pnl",
              "value": "={{ $json.today.pnl }}"
            },
            {
              "name": "strategy",
              "value": "={{ $json.strategy }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Log Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [850, 350]
    }
  ],
  "connections": {
    "Every 60 Seconds": {
      "main": [
        [
          {
            "node": "Poll Heartbeat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Heartbeat": {
      "main": [
        [
          {
            "node": "Check Alerts",
            "type": "main",
            "index": 0
          },
          {
            "node": "Pending Approvals?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Alerts": {
      "main": [
        [
          {
            "node": "Alert: Trading Halted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pending Approvals?": {
      "main": [
        [
          {
            "node": "Alert: Pending Approvals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "fathom",
      "createdAt": "2025-12-27"
    }
  ],
  "pinData": {}
}
