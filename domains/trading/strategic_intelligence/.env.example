# Strategic Intelligence Layer - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# Qdrant Vector Database Configuration
# ========================================

# Qdrant server host (default: localhost for local deployment)
QDRANT_HOST=localhost

# Qdrant server port (default: 6333)
QDRANT_PORT=6333

# Qdrant API key (leave empty for local deployment without authentication)
# For Qdrant Cloud: get from https://cloud.qdrant.io/
QDRANT_API_KEY=

# ========================================
# Logging Configuration
# ========================================

# Directory for log files
# - Local development (Windows): C:/Users/YOUR_USERNAME/logs/sil/
# - Docker deployment: /var/log/sil/
# - Production: /var/log/sil/
LOG_DIR=./transparency/logs/

# Log retention in days (default: 30)
LOG_RETENTION_DAYS=30

# ========================================
# Session Configuration
# ========================================

# Prefix for session IDs (default: sil_)
SESSION_ID_PREFIX=sil_

# ========================================
# Strategy Configuration
# ========================================

# Path to strategy configuration file (default: config/strategies.yaml)
# Override this to use alternative strategy configurations for:
# - Different trading environments (dev, paper, live)
# - Strategy backtesting and optimization
# - A/B testing different parameters
STRATEGY_CONFIG_PATH=config/strategies.yaml

# ========================================
# Learning Engine Configuration
# ========================================

# Minimum trades required before learning engine activates (default: 10)
MIN_TRADES_FOR_LEARNING=10

# Confidence threshold for parameter suggestions (default: 0.70)
LEARNING_CONFIDENCE_THRESHOLD=0.70

# ========================================
# Feature Flags
# ========================================

# Enable transparency layer (default: true)
ENABLE_TRANSPARENCY=true

# Enable memory integration (requires Qdrant, default: false)
ENABLE_MEMORY=false

# Enable learning engine (requires memory, default: false)
ENABLE_LEARNING=false

# ========================================
# Development Settings
# ========================================

# Enable debug logging (default: false)
DEBUG_MODE=false

# Console output for trace logging (default: true)
TRACE_CONSOLE_OUTPUT=true
