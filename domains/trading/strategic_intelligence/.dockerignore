# Docker build exclusions for Strategic Intelligence Layer

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# Data files (use volume mounts instead)
data/historical/*.csv
data/qdrant/*

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/
