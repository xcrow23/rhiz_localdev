{
  "name": "Mooncheck Production",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mooncheck-v2",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook_trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://72.62.81.128:5000/embed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.body.category || 'blog' }} {{ $json.body.topic_hint || '' }} {{ $json.body.transcript }}\"\n}",
        "options": {}
      },
      "id": "generate_embedding",
      "name": "Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "http://72.62.81.128:6333/collections/moonchecks/points",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"points\": [{ \"id\": $now.toUnixInteger(), \"vector\": $json.embedding, \"payload\": { \"transcript\": $('Webhook Trigger').item.json.body.transcript, \"topic_hint\": $('Webhook Trigger').item.json.body.topic_hint || '', \"category\": $('Webhook Trigger').item.json.body.category || 'blog', \"timestamp\": $now.toISO(), \"created_via\": \"ios_shortcut\", \"status\": \"captured\" } }] } }}",
        "options": {}
      },
      "id": "store_in_qdrant",
      "name": "Store in Qdrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Mooncheck captured and stored\", \"mooncheck_id\": $now.toUnixInteger(), \"timestamp\": $now.toISO() } }}",
        "options": {}
      },
      "id": "webhook_response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Generate Embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Embedding": {
      "main": [
        [
          {
            "node": "Store in Qdrant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store in Qdrant": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
