[Unit]
Description=Rhiz Memory Cloud Sync Service
After=network.target

[Service]
Type=oneshot
User=%u
WorkingDirectory=/mnt/c/Users/dread/documents/rhiz_localdev/tools/memory-sync
ExecStart=/bin/bash /mnt/c/Users/dread/documents/rhiz_localdev/tools/memory-sync/sync_auto.sh
StandardOutput=append:/mnt/c/Users/dread/documents/rhiz_localdev/tools/memory-sync/sync_auto.log
StandardError=append:/mnt/c/Users/dread/documents/rhiz_localdev/tools/memory-sync/sync_auto.log

# Environment
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Restart policy
Restart=on-failure
RestartSec=5min

[Install]
WantedBy=multi-user.target
