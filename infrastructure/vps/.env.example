# Rhiz Trading Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==================================
# KRAKEN API CREDENTIALS (REQUIRED)
# ==================================
# Obtain from: https://www.kraken.com/u/security/api
# Permissions needed: Query Funds, Create & Modify Orders, Query Open/Closed Orders
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=

# ==================================
# FC HTTP GATEWAY SECURITY (REQUIRED FOR PRODUCTION)
# ==================================
# Generate with: openssl rand -hex 32
# This API key protects the FC HTTP Gateway from unauthorized access
# Cloudflare Workers must include this in Authorization header
FC_HTTP_API_KEY=

# ==================================
# HEALTH CHECK AUTHENTICATION
# ==================================
# Used by Cloudflare Workers for health monitoring
# Generate with: openssl rand -hex 16
HEALTH_CHECK_KEY=rhiz-health-monitoring-2026

# ==================================
# TRADING CONFIGURATION
# ==================================
# Operating mode: paper, live, or disabled
FC_MODE=paper

# Maximum order size in USD
FC_MAX_ORDER_USD=50

# Orders above this threshold require Captain approval
FC_APPROVAL_THRESHOLD_USD=20

# Maximum trades per day (safety limit)
FC_MAX_DAILY_TRADES=10

# Daily loss limit - trading halts if daily loss exceeds this (USD)
FC_DAILY_LOSS_LIMIT=25

# ==================================
# SERVICE PORTS (DEFAULTS)
# ==================================
# Fathom MCP (stdio server)
FATHOM_PORT=8765

# Fathom Commander MCP (stdio server)
FC_PORT=8766

# FC HTTP Gateway (REST API)
FC_HTTP_PORT=8767

# Strategic Intelligence Layer (FastAPI)
SIL_PORT=8001

# Qdrant Vector Database
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Unified Gateway (proxy to all services)
GATEWAY_PORT=8080

# ==================================
# LOGGING
# ==================================
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
FC_LOG_LEVEL=INFO
SIL_LOG_LEVEL=INFO

# ==================================
# QDRANT CONFIGURATION
# ==================================
# Qdrant connection URL (Docker service name or IP)
QDRANT_URL=http://qdrant:6333

# ==================================
# STRATEGIC INTELLIGENCE LAYER
# ==================================
# Enable memory-augmented decision making
SIL_ENABLE_MEMORY=true

# Enable learning feedback loop (Phase 4 feature)
SIL_LEARNING_ENABLED=false

# Embedding model for semantic search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==================================
# DEPLOYMENT NOTES
# ==================================
# 1. Generate secure API keys:
#    openssl rand -hex 32  # For FC_HTTP_API_KEY
#    openssl rand -hex 16  # For HEALTH_CHECK_KEY
#
# 2. Verify Kraken API key permissions match requirements
#
# 3. Start in paper mode (FC_MODE=paper) for testing
#
# 4. Only switch to live mode after thorough paper trading validation
#
# 5. Update Cloudflare Workers with FC_HTTP_API_KEY after generation
#
# 6. Monitor logs after deployment: docker logs fc-http-gateway -f
