# ============================================================================
# RHIZ LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================================================
# IMPORTANT: Copy this file to '.env' and fill in your actual credentials
# NEVER commit the .env file to version control
# ============================================================================

# ==============================================================================
# HUMMINGBOT CONFIGURATION
# ==============================================================================
# Password for encrypting Hummingbot configuration files
# Choose a strong password - this protects your API keys
HUMMINGBOT_PASSWORD=your_secure_password_here

# Kraken API Credentials (for trading domain)
# Get these from: https://www.kraken.com/u/security/api
# Recommended permissions for testing: Query Funds, Query Open Orders (READ ONLY)
# For live trading, add: Create & Modify Orders, Cancel/Close Orders
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET_KEY=your_kraken_secret_key_here

# ==============================================================================
# CLAUDE API CONFIGURATION
# ==============================================================================
# Anthropic API Key (for Claude API usage outside Claude Code)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Model preferences (defaults to latest if not set)
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001

# ==============================================================================
# LOCALAI CONFIGURATION
# ==============================================================================
# Models to preload on startup (comma-separated)
# Leave empty for manual model loading
# Example: qwen2.5-coder:7b,deepseek-r1:8b
LOCALAI_PRELOAD_MODELS=

# LocalAI API endpoint (if using external instance)
# LOCALAI_API_ENDPOINT=http://localhost:8080

# ==============================================================================
# N8N CONFIGURATION (Hostinger Cloud Instance)
# ==============================================================================
# n8n webhook base URL
N8N_WEBHOOK_URL=https://your-n8n-instance.hostinger.com

# n8n API key (for programmatic workflow triggering)
N8N_API_KEY=your_n8n_api_key_here

# Hostinger SSH credentials (for deployment)
HOSTINGER_SSH_HOST=your-vps-hostname.hostinger.com
HOSTINGER_SSH_USER=your_ssh_username
# Note: Use SSH key authentication (Rhiz_onekey), not password

# ==============================================================================
# MUSIC PRODUCTION (Claude_Grooves Integration)
# ==============================================================================
# MusicAPI.ai credentials
MUSICAPI_AI_KEY=your_musicapi_key_here

# Soundraw API credentials (if using API instead of web interface)
SOUNDRAW_API_KEY=your_soundraw_key_here

# Ableton MCP configuration (if using local MCP server)
ABLETON_MCP_PORT=8081

# ==============================================================================
# DATABASE & CACHING
# ==============================================================================
# Redis connection (default: local Docker container)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # Set if using external Redis with auth

# ==============================================================================
# MONITORING & TELEMETRY
# ==============================================================================
# Optional: OpenTelemetry endpoint for monitoring
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional: Enable debug logging for specific services
# DEBUG_HUMMINGBOT=false
# DEBUG_LOCALAI=false

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================
# External backup drive path (for 3-2-1 backup rule)
BACKUP_EXTERNAL_PATH=E:\Rhiz_Backups
# Cloud backup path (OneDrive, Google Drive, etc.)
BACKUP_CLOUD_PATH=C:\Users\dread\OneDrive\Rhiz_Backups

# ==============================================================================
# ENVIRONMENT METADATA
# ==============================================================================
# Helps track which environment this is (dev/staging/prod)
ENVIRONMENT=development
# Hardware identifier
MACHINE_NAME=inspiron-15-3535

# ==============================================================================
# NOTES
# ==============================================================================
# 1. After creating .env from this template, run: docker-compose config
#    This validates your configuration before starting services
#
# 2. To rotate API keys:
#    - Update .env with new credentials
#    - Restart affected services: docker-compose restart [service_name]
#
# 3. For Windows Credential Manager integration (future):
#    - Store sensitive keys in Windows Credential Manager
#    - Reference via helper scripts instead of .env
#
# 4. Security checklist:
#    [ ] .env file is in .gitignore
#    [ ] File permissions restrict access (chmod 600 .env on Linux/WSL)
#    [ ] No API keys in docker-compose.yml
#    [ ] Kraken API keys are READ-ONLY for initial testing
#    [ ] Backup .env to encrypted external drive
#
# ==============================================================================
